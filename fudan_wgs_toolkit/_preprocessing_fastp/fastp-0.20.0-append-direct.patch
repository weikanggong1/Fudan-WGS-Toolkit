+namespace {
+// Compute the complete append length before resizing or writing the target.
+size_t readAppendLength(size_t nameLen, size_t seqLen, size_t strandLen,
+                        size_t qualLen, size_t remaining) {
+    size_t size = 4; // Four original LF separators, including the last one.
+    if (size > remaining)
+        throw std::length_error("FASTQ append exceeds string capacity");
+    const size_t lengths[] = {nameLen, seqLen, strandLen, qualLen};
+    for (size_t length : lengths) {
+        if (length > remaining - size)
+            throw std::length_error("FASTQ append exceeds string capacity");
+        size += length;
+    }
+    return size;
+}
+}
+
+void Read::appendToString(string* target) {
+    // The PE output buffers never alias a read field. Reject invalid new-API
+    // targets before mutation rather than invalidating a source during resize.
+    if (!target || target == &mName || target == &mSeq.mStr ||
+        target == &mStrand || target == &mQuality)
+        throw std::invalid_argument("FASTQ append requires a separate target string");
+    const size_t oldSize = target->size();
+    const size_t totalSize = readAppendLength(mName.size(), mSeq.mStr.size(),
+        mStrand.size(), mQuality.size(), target->max_size() - oldSize);
+    // C++11 string::resize leaves the original target unchanged if allocation
+    // fails. Once this succeeds the following bounded memcpy calls cannot throw.
+    target->resize(oldSize + totalSize);
+    char* dst = &(*target)[oldSize];
+    std::memcpy(dst, mName.data(), mName.size()); dst += mName.size(); *dst++ = '\n';
+    std::memcpy(dst, mSeq.mStr.data(), mSeq.mStr.size()); dst += mSeq.mStr.size(); *dst++ = '\n';
+    std::memcpy(dst, mStrand.data(), mStrand.size()); dst += mStrand.size(); *dst++ = '\n';
